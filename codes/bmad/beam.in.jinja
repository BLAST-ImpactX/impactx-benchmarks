&beam_track_params
  lat_filename = '{{ lat_filename }}'
  ran_seed = 12345
  spin = {{ spin }}
  n_warmup = 1
  beam_init%n_particle = {{ npart }}
  beam_init%n_bunch = 1
  beam_init%a_emit = {{ params.emit_x }}
  beam_init%b_emit = {{ params.emit_y }}
  beam_init%sig_z = {{ params.sigma_t }}
  beam_init%sig_pz = {{ params.sigma_p }}
  beam_init%center(6) = {{ params.get('mu_p', 0.0) }}
  beam_init%distribution_type = 'ran_gauss', 'ran_gauss', 'ran_gauss'
{% if spin == 'T' %}
  beam_init%spin = 0.0, 0.0, 1.0
{% endif %}
{% if space_charge|default('F') == 'T' %}
  ! Pin the converter: the default 'ziggurat' sampled kurtosis 3.65 instead of 3 on a Bmad checkout
  ! from 2026-06-17, which alone moved this scenario's RMS transverse kicks by several percent.
  beam_init%random_gauss_converter = 'exact'
  beam_init%bunch_charge = {{ params.bunch_charge_C }}
  space_charge = T
  sc_ds = {{ params.drift_length }}
  sc_mesh = {{ params.n_cell }}, {{ params.n_cell }}, {{ params.n_cell }}
{% endif %}
/
