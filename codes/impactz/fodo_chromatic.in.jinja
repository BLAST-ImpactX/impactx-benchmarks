{#-
  IMPACT-Z input deck: chromatic FODO tracking benchmark (no space charge).

  Model matched to the ImpactX reference (ChrQuad + ChrDrift, chromatic-paraxial):
    * quad:  type-1 quadrupole with fileID = -1 (Param(3) in (-10,-1e-6)) selects
             IMPACT-Z's `transfmapK_Quadrupole` -- a THICK CHROMATIC quad map whose
             strength is scaled per particle by gambet0/gambet = K/(1+delta) and whose
             x-px transport uses the per-particle momentum. That is exactly the
             chromatic-paraxial thick-quad model (= ImpactX ChrQuad). Param(2) = K is
             the MAD-X geometric strength (1/m^2, G/Brho), same sign as ChrQuad unit=0.
    * drift: type-0 drift is IMPACT-Z's EXACT non-paraxial drift
             (Ps = sqrt((pt-gam0)^2 - 1 - px^2 - py^2)), matching ImpactX ExactDrift.
    * no space charge: Bcurrent = 0 -> the SC solve is skipped entirely (Bcurr<1e-10).
    * beam: Gaussian sampled from the SAME Twiss/emittance/energy as ImpactX
            (Flagdist=2). The mesh line is required by the deck format but unused
            (SC off), so a small 32^3 grid is declared.

  Coordinate/units bridge is identical to the validated spacecharge deck: transverse
  in the length scale xl=c/(2*pi*f_ref); longitudinal in RF phase[deg] & energy[MeV].
  f_ref is a free normalisation for this RF-less line; read_fort.py converts back to SI.
-#}
{% set c = 299792458.0 %}
{% set pi = 3.141592653589793 %}
{% set fref = 1.3e9 %}
{% set mass_eV = params.mass_MeV * 1.0e6 %}
{% set kin_eV = params.kin_energy_MeV * 1.0e6 %}
{% set gamma = 1.0 + params.kin_energy_MeV / params.mass_MeV %}
{% set betagamma = (gamma * gamma - 1.0) ** 0.5 %}
{% set beta = betagamma / gamma %}
{% set xl = c / (2.0 * pi * fref) %}
{% set emit_nx = params.emit_x * betagamma %}
{% set emit_ny = params.emit_y * betagamma %}
{% set sigphi_deg = params.sigma_t / (beta * xl) * 180.0 / pi %}
{% set sigE_MeV = beta * betagamma * params.sigma_p * params.mass_MeV %}
{% set betaz = sigphi_deg / sigE_MeV %}
{% set epsz = sigphi_deg * sigE_MeV %}
{% set qmc = -1.0 / mass_eV %}
{% set kq = params.k1 %}
!IMPACT-Z chromatic FODO tracking benchmark (auto-generated; matched to ImpactX ChrQuad+ChrDrift).
!--- processor grid: npcol(Y) nprow(Z); the driver rewrites this to match --ranks
1 1
!--- 6D, npart particles/charge, Flagmap(1=linear-map path: exact drift + transfMapK quad), Flagerr(0), Flagdiag(1)
6 {{ npart }} 1 0 1
!--- Nx Ny Nz, Flagbc(1=3D open BC), x/y pipe half-width[m] (unused, SC off), period[m]
32 32 32 1 1.0 1.0 1.0
!--- Flagdist(2=3D Gaussian), restart(0), subcycle(0), #charge-states(1)
2 0 0 1
!--- # particles per charge state
{{ npart }}
!--- current[A] per charge state = 0 (no space charge)
0.0
!--- q/m per charge state, normalised = charge/mass[eV] (electron: -1/mass)
{{ "%.12e"|format(qmc) }}
!--- X: alpha  beta[m]  eps_norm[m.rad]  xscale pxscale  xoff pxoff
{{ "%.12e"|format(params.alpha_x) }} {{ "%.12e"|format(params.beta_x) }} {{ "%.12e"|format(emit_nx) }} 1.0 1.0 0.0 0.0
!--- Y: alpha  beta[m]  eps_norm[m.rad]  yscale pyscale  yoff pyoff
{{ "%.12e"|format(params.alpha_y) }} {{ "%.12e"|format(params.beta_y) }} {{ "%.12e"|format(emit_ny) }} 1.0 1.0 0.0 0.0
!--- Z: alpha_z  beta_z[deg/MeV]  eps_z[deg.MeV]  zscale pzscale  zoff pzoff
0.0 {{ "%.12e"|format(betaz) }} {{ "%.12e"|format(epsz) }} 1.0 1.0 0.0 0.0
!--- Bcurrent[A]=0  Bkin_energy[eV]  Bmass[eV]  Bcharge  Bfreq[Hz]  Bphase[deg]
0.0 {{ "%.12e"|format(kin_eV) }} {{ "%.12e"|format(mass_eV) }} -1.0 {{ "%.12e"|format(fref) }} 0.0
!====================== ACC. LATTICE ======================
!--- FODO: QF(+k1) drift QD(-k1) drift.  quad line: L nseg mapstp 1 K fileID(-1=transfMapK chromatic) radius
{{ "%.12e"|format(params.quad_length) }} 1 1 1 {{ "%.12e"|format(kq) }} -1.0 1.0 /
{{ "%.12e"|format(params.drift_length) }} 1 1 0 1.0 /
{{ "%.12e"|format(params.quad_length) }} 1 1 1 {{ "%.12e"|format(-kq) }} -1.0 1.0 /
{{ "%.12e"|format(params.drift_length) }} 1 1 0 1.0 /
